-- 4. SOLVE ALL 10 OPERATIONS

-- Operation 1: Rename assets to property

alter table branch
change column assets property decimal(15,2) not null;


-- Operation 2: Find loan numbers at SBI Jejuri
-- with loan amount greater than 12000

select loan_no
from loan
where branch_name = 'sbi_jejuri'
and amount > 12000;


-- Operation 3: Average account balance at each branch

select branch_name, avg(balance) as average_balance
from account
group by branch_name;


-- Operation 4: Branches with average balance greater than 12000

select branch_name, avg(balance) as average_balance
from account
group by branch_name
having avg(balance) > 12000;


-- Operation 5: Count total customers

select count(*) as total_customers
from customer;


-- Operation 6: Total loan amount given by bank

select sum(amount) as total_loan_amount
from loan;


-- Operation 7: Delete loans with amount between 1300 and 1500

delete from borrower
where loan_no in (
    select loan_no
    from loan
    where amount between 1300 and 1500
);

delete from loan
where amount between 1300 and 1500;


