2. Display the names and cities of customers whose names start with the letter 'P'. 
 select cust_name, city from Customer WHERE cust_name LIKE 'P%';

3. Display customers who live in Pune or Mumbai and whose phone number is not NULL. 
select * FROM Customer WHERE city = 'Pune' || city = 'Mumbai' AND phone IS NOT NULL;

4. Display all customers whose phone number is NULL. 
select * from Customer WHERE phone is NULL;

5. Display the average account balance for each branch. 
select b.branch_name, AVG(a.balance) AS avg_balance
    -> FROM Branch b
    -> JOIN Account a ON b.branch_id = a.branch_id
    -> GROUP BY b.branch_name;

6. Display the branch-wise average account balance and show only those branches where the average balance is greater than ₹40,000. 
select b.branch_name, AVG(a.balance) AS avg_balance
    -> FROM Branch b
    -> JOIN Account a ON b.branch_id = a.branch_id
    -> GROUP BY b.branch_name
-> HAVING AVG(a.balance) > 40000;

7. Display each account number along with its balance after adding 10% interest. Do not modify the actual balance. 
select acc_no, balance, balance * 1.10 AS update_balance from Account;

8. Update the phone number of a specific customer using the customer's name. 
UPDATE Customer SET Phone = '999999999' WHERE cust_name = 'Amit';

