-- operation 1 alphabetical order names 
select *from customer 
order by cust_name ASC;

-- operation 2  Display the names and cities of customers whose names start with the letter 'P'.
select cust_name ,city from customer
where cust_name LIKE 'p%';

-- operation 3  Display customers who live in Pune or Mumbai and whose phone number is not NULL. 
select * from customer
where (city='pune' ||city ='mumbai') AND phone is not null;

-- opertaion 4  Display all customers whose phone number is NULL. 
select * from customer 
where phone is null;

-- operation 5 Display the average account balance for each branch. 
select branch_name ,avg(account.balance) as avg_balance
from branch
join account
on branch.branch_id=account.branch_id
group  by branch_name;

-- operation 6  Display the branch-wise average account balance and show only those branches where the average balance is greater than ₹40,000
select branch_name ,avg(account.balance) as avg_balance
from branch
join account
on branch.branch_id=account.branch_id
group by branch_name
having avg(account.balance)>40000;

-- operation 7 Display each account number along with its balance after adding 10% interest. Do not modify the actual balance. 
select acc_no ,balance ,balance*1.1 as updated_balance
from account;

