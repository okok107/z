1. Display all customers who live in Pune or Mumbai, arranged in alphabetical order of their names. 
mysql> select * from Customer WHERE city = 'Pune' || city = 'Mumbai' ORDER BY cust_name ASC;

OR) select * from Customer WHERE city IN ('Pune', 'Mumbai') ORDER BY cust_name ASC;

2. Display the names of customers whose names contain the letter 'a'. 
mysql> select * from Customer WHERE cust_name LIKE '%a%';

3. Display all customers whose phone number is NOT NULL. 
mysql> select * from Customer WHERE phone IS NOT NULL;

4. Display customers who live in Pune and whose names start with 'P', or customers who live in Mumbai. 
mysql> select * from Customer WHERE (city = 'Pune' AND cust_name LIKE 'P%') OR city = 'Mumbai' ;

5. Display the maximum loan amount and the average loan amount for each branch. 
mysql> select b.branch_name,
    -> MAX(l.amount) AS max_loan,
    -> AVG(l.amount) AS avg_loan
    -> FROM Branch b
    -> JOIN Loan l ON b.branch_id = l.branch_id
    -> GROUP BY b.branch_id, b.branch_name;

6. Display branches whose total loan amount is greater than ₹1,00,000. 
mysql> select b.branch_name, SUM(l.amount) AS total_amount
    -> FROM Branch b
    -> JOIN Loan l ON b.branch_id = l.branch_id
    -> GROUP BY b.branch_id, b.branch_name
    -> HAVING SUM(l.amount) > 100000;

7. Display each account number along with its balance after adding ₹500. Do not modify the actual balance. 
mysql> select acc_no, balance, balance+500 AS update_balance FROM Account;

8. Change the branch of account number 2005 to a different branch. 
mysql> UPDATE Account SET branch_id = 105 WHERE acc_no = 2005;

9. Delete all customers whose phone number is NULL. 
mysql> DELETE FROM Customer WHERE phone is NULL;

10. Display:a) Customers who have both an account and a loan using INTERSECT. 
mysql> select cust_id, cust_name FROM Customer JOIN Account USING (cust_id)
    -> INTERSECT
    -> select cust_id, cust_name FROM Customer JOIN Loan USING (cust_id);

b) Customers who have an account but no loan using MINUS. 
mysql> select cust_id, cust_name FROM Customer JOIN Account USING (cust_id)
    -> MINUS
    -> select cust_id, cust_name FROM Customer JOIN Loan USING (cust_id);
