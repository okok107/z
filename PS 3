create database icem_ps_2;
use icem_ps_2;

create table student(
student_id int primary key,
 name varchar(30), 
 city varchar(30)
 );
 
 create table enrolments(
 enroll_id int primary key, 
 student_id int, 
 course varchar(30), 
 marks int, 
 foreign key(student_id) references student(student_id)
 );
 
