-- operation 1 . Display student names and the courses in which they are enrolled
select s.student_id,s.name ,e.course,e.marks
from student s 
join enrolments e
on s.student_id=e.student_id;

-- opartion 2  Display all students and their course details, including students who are not enrolled in any course.
select s.student_id,s.name ,e.course,e.marks
from student s 
left join enrolments e
on s.student_id=e.student_id;

-- operation 3  Display all students and their course details, including students who are not enrolled in any course.
select s.student_id,s.name ,e.course,e.marks
from student s 
join enrolments e
on s.student_id=e.student_id
where e.course ='DBMS';

-- operation 4  Display enrollments that do not have a matching student record.
select s.student_id,s.name ,e.course,e.marks
from student s 
right join enrolments e
on s.student_id=e.student_id
where s.student_id is null;

-- operation 5 Display students who have obtained marks less than the average marks of all enrollments.
select s.student_id,s.name,e.marks
from student s
inner join enrolments e
on s.student_id =e.student_id
where marks<(select avg(e.marks) from enrolments);

-- operation 6 Display students who have obtained marks equal to the highest marks
select s.student_id ,s.name,e.marks
from student s
inner join enrolments e 
on s.student_id=e.student_id
where marks=(select max(marks) from enrolments);

-- operation 7 Display students who belong to Pune.
select student_id,name from student
where city='pune';

-- operation 8  Display students enrolled in Python
select s.student_id,s.name 
from student s
join enrolments e
on s.student_id=e.student_id
where e.course ='python';

-- operation 9 Create a view named course_average_view displaying course names and their average marks. Display all records from the view.
create view course_average_view as
select course,avg(marks) as avg_marks
from enrolments
group by course;

select * from course_average_view;

