CREATE OR REPLACE TRIGGER trg_lib_audit
BEFORE UPDATE OR DELETE ON Library
FOR EACH ROW
BEGIN
    IF UPDATING THEN
        INSERT INTO Library_Audit
        VALUES (
            :OLD.bookid, :OLD.bookname, :OLD.author,
            :OLD.category, :OLD.publishdate, 'UPDATE', SYSDATE
        );
    ELSIF DELETING THEN
        INSERT INTO Library_Audit
        VALUES (
            :OLD.bookid, :OLD.bookname, :OLD.author,
            :OLD.category, :OLD.publishdate, 'DELETE', SYSDATE
        );
    END IF;
END;
/

