CREATE OR REPLACE PROCEDURE proc_Grade IS
BEGIN
    FOR s IN (
        SELECT rollno, name, total_marks
        FROM Stud_Marks
    )
    LOOP
        IF s.total_marks >= 990 AND s.total_marks <= 1500 THEN
            INSERT INTO Result
            VALUES (s.rollno, s.name, 'Distinction');

        ELSIF s.total_marks >= 900 THEN
            INSERT INTO Result
            VALUES (s.rollno, s.name, 'First Class');

        ELSIF s.total_marks >= 825 THEN
            INSERT INTO Result
            VALUES (s.rollno, s.name, 'Higher Second Class');

        ELSE
            INSERT INTO Result
            VALUES (s.rollno, s.name, 'Fail');
        END IF;
    END LOOP;

    COMMIT;
END;
/


