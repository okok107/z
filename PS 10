4. Find the names of all branches in the Loan relation
SELECT DISTINCT branch_name FROM Loan;

5. Find all customers who have a loan from the bank
SELECT B.cust_name, L.loan_no, L.amount
FROM Borrower B
JOIN Loan L
    ON B.loan_no = L.loan_no;

6. List all customers in alphabetical order who have a loan from Akurdi branch
SELECT DISTINCT B.cust_name
FROM Borrower B
JOIN Loan L
    ON B.loan_no = L.loan_no
WHERE L.branch_name = 'Akurdi'
ORDER BY B.cust_name ASC;

7. Find the average account balance at Chinchwad branch
SELECT AVG(balance) AS average_balance
FROM Account
WHERE branch_name = 'Chinchwad';

8. Find the number of depositors at each branch
SELECT A.branch_name,
       COUNT(DISTINCT D.cust_name) AS no_of_depositors
FROM Account A
JOIN Depositor D
    ON A.acc_no = D.acc_no
GROUP BY A.branch_name;

9. Find the total loan amount for each branch
SELECT branch_name,
       SUM(amount) AS total_loan_amount
FROM Loan
GROUP BY branch_name;

10. Find branches where the average loan amount is greater than ₹5,00,000
SELECT branch_name,
       AVG(amount) AS average_loan_amount
FROM Loan
GROUP BY branch_name
HAVING AVG(amount) > 500000;
