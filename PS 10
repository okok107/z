from borrower b
join loan l
on b.loan_no=l.loan_no;

-- operation 6. List all customers in alphabetical order who have loan from Akurdi branch
select b.cust_name, b.loan_no, l.amount
from borrower b
join loan l
on b.loan_no = l.loan_no
where l.branch_name = 'sbi_jejuri'
order by b.cust_name asc;

-- operation 7 
select avg(balance) as average_balance
from account
where branch_name = 'chinchwad';

-- operation 8 . Find no. of depositors at each branch
select a.branch_name, count(distinct d.cust_name) as total_depositors
from account a
join depositor d
on a.acc_no = d.acc_no
group by a.branch_name;

-- operation 9  Find the total loan amount for each branch
select branch_name, sum(amount) as total_loan
from loan
group by branch_name;

-- operation 10 Find the branches where the average loan amount is greater than 5,00,000
select branch_name, avg(amount) as average_loan
from loan
group by branch_name
having avg(amount) > 500000;
