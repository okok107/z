1. Display the information of all students. 
Enterprise test> db.student.find()

2. Display the information of students belonging to the Computer department. 
Enterprise Student> db.student.find({dept: "Computer"})

3. Display the information of students belonging to the Computer or IT department using a logical operator. 
db.student.find({
  $or: [
    {dept: "Computer"},
    {dept: "IT"}
  ]
})

4. Display the information of students whose marks are greater than 70. 
db.student.find({marks: {$gt: 70}})

5. Display the information of students whose marks are greater than or equal to 80 and who belong to the Computer department. 
db.student.find({
  marks: {$gte: 80},
  dept: "Computer"
})

6. Display the information of students whose marks are less than 40 or who belong to the IT department. 
db.student.find({
  $or: [
    {marks: {$lt: 40}},
    {dept: "IT"}
  ]
})

7. Display the information of students whose marks are between 40 and 80. 
db.student.find({
  marks: {$gte: 40, $lte: 80}
})

8. Display the information of students whose department is not IT. 
db.student.find({dept: {$ne: "IT"}})

9. Display the total marks of students in each department. 
db.student.aggregate([
  {
    $group: {
      _id: "$dept",
      total_marks: {$sum: "$marks"}
    }
  }
])

