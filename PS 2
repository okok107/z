-- operation 1 Display student names along with their course names and marks.
select student.name,enrolments.course,enrolments.marks
from student
inner join enrolments
on student.student_id=enrolments.student_id;

-- operation 2  Display all students along with their course names and marks, including students who are not enrolled in any course. 
select student.name,enrolments.course,enrolments.marks
from student
left join  enrolments
on student.student_id=enrolments.student_id;

-- operartion 3 Display all enrollments along with the corresponding student names. 
select student.name , enrolments.enroll_id ,enrolments.course
from enrolments 
inner join student 
on student.student_id=enrolments.student_id;

-- operation 4 . Display all possible combinations of students and courses.
select student.name,student.student_id,enrolments.course,enrolments.enroll_id 
from student
cross join enrolments;

--  operation 5 Display students whose marks are greater than the average marks of all enrollments 
select student.student_id,student.name
from student
join enrolments 
on student.student_id=enrolments.student_id
where enrolments.marks>(select avg(marks) from enrolments);

-- operation 6 Display students who have obtained marks greater than 80 
select student.student_id,student.name, enrolments.marks
from student
join enrolments 
on student.student_id=enrolments.student_id
where enrolments.marks>80;

-- operation 7 Display students who are enrolled in the DBMS course 
select student.student_id,student.name
from student 
inner join enrolments
on student.student_id=enrolments.student_id
where enrolments.course='DBMS';

-- opration 8 Display the student ID(s) who have obtained the highest marks 
select student_id from enrolments
where marks=(select max(marks) from enrolments);

-- operation 9 Create a view named student_course_view displaying student names, course names, and marks. Display all records from the view and update the marks of a student through the view.
create view stu_view  as
select student.student_id,student.name ,enrolments.course,enrolments.marks
from student 
join enrolments
on student.student_id=enrolments.student_id;

select *from stu_view;

update stu_view 
set marks=90
where student_id=1;	

